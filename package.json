{
  "name": "clothing-store-pos",
  "version": "2.0.0",
  "description": "\u0646\u0638\u0627\u0645 \u0643\u0627\u0634\u064a\u0631 \u0645\u062d\u0644 \u0645\u0644\u0627\u0628\u0633 - \u064a\u0639\u0645\u0644 \u0628\u062f\u0648\u0646 \u0625\u0646\u062a\u0631\u0646\u062a",
  "author": "Moaz Elshazly",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.moazelshazly.clothingpos",
    "productName": "Clothing POS",
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true,
      "forceCodeSigning": false
    },
    "compression": "normal",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "language": "1025"
    }
  },
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "26.18.0"
  }
}
